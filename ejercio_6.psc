Algoritmo ejercio_6
	Escribir " introduce un numero"
	leer numero 
	//si el numero es mayor que 0 ,calcula la pontencia y la raiz
	//sino muestra un mensaje de error y sale del progarama 
	si (numero>-0) Entonces
		potencia<-numero^2
		raiz_cuadrad<-raiz(numero)
		escribir"su potencia es " pontencia 
		escribir"su raiz es" raiz_cuadrad
	sino 
		escribir"error,introduce un numero mayor que 0"   
	FinSi
	
FinAlgoritmo
